    "---\n",
    "# PART 3: DETAILED ANALYSIS FIGURES\n",
    "\n",
    "5 detailed analysis figures with statistical tests"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## S1: RF vs LP Detailed Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Supplementary Figure S1 already generated: sup_s1_rf_vs_lp.pdf\n",
    "# Show key statistics\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"SUP FIGURE S1: RF vs LP Detailed Statistics\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "models_lp = [\n",
    "    ('fm_NTv3_650M_pre_MCC', 'lp_fm_NTv3_650M_pre_MCC__pool_max', 'NTv3'),\n",
    "    ('fm_hyenadna-medium-160k-seqlen-hf_MCC', 'lp_fm_hyenadna-medium-160k-seqlen-hf_MCC', 'HyenaDNA'),\n",
    "    ('fm_DNABERT-2-117M_MCC', 'lp_fm_DNABERT-2-117M_MCC', 'DNABERT-2'),\n",
    "]\n",
    "\n",
    "for rf_col, lp_col, model in models_lp:\n",
    "    if rf_col in rf.columns and lp_col in lp.columns:\n",
    "        merged = rf[['dataset', rf_col]].merge(lp[['dataset', lp_col]], on='dataset')\n",
    "        x = merged[rf_col].dropna().values\n",
    "        y = merged[lp_col].dropna().values\n",
    "        delta = x - y\n",
    "        \n",
    "        print(f\"\\n{model}:\")\n",
    "        print(f\"  RF wins: {(delta > 0).sum()}/57 ({100*(delta > 0).sum()/57:.1f}%)\")\n",
    "        print(f\"  LP wins: {(delta < 0).sum()}/57 ({100*(delta < 0).sum()/57:.1f}%)\")\n",
    "        print(f\"  Median Δ: {np.median(delta):+.4f}\")\n",
    "        print(f\"  Mean Δ:   {np.mean(delta):+.4f}\")\n",
    "        print(f\"  Std Δ:    {np.std(delta):.4f}\")\n",
    "        \n",
    "        # Paired t-test\n",
    "        t_stat, p_val = stats.ttest_rel(x, y)\n",
    "        print(f\"  t-test:   t={t_stat:.4f}, p={p_val:.4e} {'***' if p_val < 0.001 else '**' if p_val < 0.01 else '*' if p_val < 0.05 else 'ns'}\")\n",
    "\n",
    "print(\"=\"*80)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## S2: AUROC vs MCC Correlation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Supplementary Figure S2 already generated: sup_s2_auroc_vs_mcc.pdf\n",
    "# Show correlation statistics\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"SUP FIGURE S2: AUROC vs MCC Correlation Analysis\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "models_metrics = [\n",
    "    ('NTv3_650M_pre', 'NTv3'),\n",
    "    ('hyenadna-medium-160k-seqlen-hf', 'HyenaDNA'),\n",
    "    ('DNABERT-2-117M', 'DNABERT-2'),\n",
    "    ('caduceus-ph_seqlen-131k_d_model-256_n_layer-16', 'Caduceus'),\n",
    "]\n",
    "\n",
    "metric_results = []\n",
    "for model_key, label in models_metrics:\n",
    "    mcc_col = f'fm_{model_key}_MCC'\n",
    "    auroc_col = f'fm_{model_key}_AUROC'\n",
    "    \n",
    "    if mcc_col in rf.columns and auroc_col in rf.columns:\n",
    "        mcc_vals = rf[mcc_col].dropna().values\n",
    "        auroc_vals = rf[auroc_col].dropna().values\n",
    "        \n",
    "        # Pearson correlation\n",
    "        pearson_r, p_val = stats.pearsonr(mcc_vals, auroc_vals)\n",
    "        \n",
    "        metric_results.append({\n",
    "            'Model': label,\n",
    "            'Pearson_r': f'{pearson_r:.4f}',\n",
    "            'p_value': f'{p_val:.2e}',\n",
    "            'MCC_median': f'{np.median(mcc_vals):.3f}',\n",
    "            'AUROC_median': f'{np.median(auroc_vals):.3f}'\n",
    "        })\n",
    "\n",
    "metric_df = pd.DataFrame(metric_results)\n",
    "print(metric_df.to_string(index=False))\n",
    "print(\"=\"*80)\n",
    "print(\"\\n→ Interpretation: All r > 0.95, meaning AUROC and MCC rankings are nearly identical\")\n",
    "print(\"→ Implication: Benchmark results are robust to metric choice\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## S3: k-mer Order Statistical Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Supplementary Figure S3: detailed k-mer analysis\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"SUP FIGURE S3: k-mer Order Analysis (k=4, 5, 6)\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "k4 = rf['kmer_k4_MCC'].dropna().values\n",
    "k5 = rf['kmer_k5_MCC'].dropna().values\n",
    "k6 = rf['kmer_k6_MCC'].dropna().values\n",
    "\n",
    "kmer_order_stats = pd.DataFrame([\n",
    "    {\n",
    "        'k-mer': 'k=4 (256D)',\n",
    "        'N': len(k4),\n",
    "        'Median': f'{np.median(k4):.3f}',\n",
    "        'Mean': f'{np.mean(k4):.3f}',\n",
    "        'Std': f'{np.std(k4):.3f}',\n",
    "        'Q25': f'{np.percentile(k4, 25):.3f}',\n",
    "        'Q75': f'{np.percentile(k4, 75):.3f}'\n",
    "    },\n",
    "    {\n",
    "        'k-mer': 'k=5 (1024D)',\n",
    "        'N': len(k5),\n",
    "        'Median': f'{np.median(k5):.3f}',\n",
    "        'Mean': f'{np.mean(k5):.3f}',\n",
    "        'Std': f'{np.std(k5):.3f}',\n",
    "        'Q25': f'{np.percentile(k5, 25):.3f}',\n",
    "        'Q75': f'{np.percentile(k5, 75):.3f}'\n",
    "    },\n",
    "    {\n",
    "        'k-mer': 'k=6 (4096D)',\n",
    "        'N': len(k6),\n",
    "        'Median': f'{np.median(k6):.3f}',\n",
    "        'Mean': f'{np.mean(k6):.3f}',\n",
    "        'Std': f'{np.std(k6):.3f}',\n",
    "        'Q25': f'{np.percentile(k6, 25):.3f}',\n",
    "        'Q75': f'{np.percentile(k6, 75):.3f}'\n",
    "    },\n",
    "])\n",
    "\n",
    "print(\"\\nDistribution Statistics:\")\n",
    "print(kmer_order_stats.to_string(index=False))\n",
    "\n",
    "# Pairwise statistical tests\n",
    "t45, p45 = stats.ttest_rel(k4, k5)\n",
    "t56, p56 = stats.ttest_rel(k5, k6)\n",
    "t46, p46 = stats.ttest_rel(k4, k6)\n",
    "\n",
    "print(\"\\nPaired t-tests:\")\n",
    "print(f\"  k=4 vs k=5: t={t45:.4f}, p={p45:.4e} {'***' if p45 < 0.001 else '**' if p45 < 0.01 else '*'}\")\n",
    "print(f\"  k=5 vs k=6: t={t56:.4f}, p={p56:.4e} {'***' if p56 < 0.001 else '**' if p56 < 0.01 else '*'}\")\n",
    "print(f\"  k=4 vs k=6: t={t46:.4f}, p={p46:.4e} {'***' if p46 < 0.001 else '**' if p46 < 0.01 else '*'}\")\n",
    "\n",
    "print(\"\\nEffect Sizes (Cohen's d):\")\n",
    "d45 = (np.mean(k4) - np.mean(k5)) / np.sqrt((np.std(k4)**2 + np.std(k5)**2)/2)\n",
    "d56 = (np.mean(k5) - np.mean(k6)) / np.sqrt((np.std(k5)**2 + np.std(k6)**2)/2)\n",
    "print(f\"  k=4 vs k=5: d={d45:.3f}\")\n",
    "print(f\"  k=5 vs k=6: d={d56:.3f}\")\n",
    "\n",
    "print(\"=\"*80)\n",
    "print(\"\\n→ Key finding: k=5 is statistically superior to k=4 and k=6\")\n",
    "print(\"→ Interpretation: Best bias-variance tradeoff for k-mer methods\")"
   ]
  },
